OSIP_ENVIRONMENT=development
OSIP_DATABASE_URL=postgresql+psycopg://osip:osip@localhost:5432/osip
OSIP_BLOB_ROOT=.data/source-files
OSIP_IDENTITY_PROVIDER=development
# Required when OSIP_IDENTITY_PROVIDER=oidc:
# OSIP_OIDC_ISSUER=https://identity.example.com/realms/portfolio-ops-insight
# OSIP_OIDC_AUDIENCE=osip-portfolio-dashboard
# OSIP_OIDC_JWKS_URL=https://identity.example.com/realms/portfolio-ops-insight/protocol/openid-connect/certs
# OSIP_OIDC_ROLE_MAPPING={"osip-upload":"uploader","osip-review":"reviewer","osip-publish":"publisher","osip-read":"reader"}
# OSIP_OIDC_ROLES_CLAIM=realm_access.roles
# OSIP_OIDC_PORTFOLIOS_CLAIM=osip_portfolios
OSIP_MAX_UPLOAD_BYTES=104857600
# Risk watchlist policy: utilization ratio at/above this threshold and below
# 100% is classified as near-breach. Record a new policy version when changed.
OSIP_RISK_NEAR_BREACH_THRESHOLD=0.90
OSIP_RISK_NEAR_BREACH_POLICY_VERSION=utilization-ratio-v1
OSIP_CORS_ORIGINS=["http://localhost:5173"]
